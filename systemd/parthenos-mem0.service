[Unit]
Description=Mem0 substrate stack (postgres+pgvector, neo4j) via docker compose
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/projects/Parthenos/deploy/mem0
ExecStart=/usr/bin/docker compose up -d postgres neo4j
ExecStop=/usr/bin/docker compose stop postgres neo4j
TimeoutStartSec=300

[Install]
WantedBy=default.target
