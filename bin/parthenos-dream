#!/usr/bin/env python3
"""Lucid-dream nightly calibration runner.

Usage: bin/parthenos-dream [--store SNAPSHOT.json] [--out report.json]
Loads an S5 graph snapshot (optional), computes calibration proposals, and
writes the report. Never mutates the graph or layer constants.
"""
import argparse
import sys

sys.path.insert(0, __file__.rsplit("/", 2)[0])

from parthenos.dream_cli import (
    load_store_from_snapshot,
    run_report,
    write_report,
)
from parthenos.graph import GraphStore

DEFAULT_OUT = "~/projects/Parthenos/data/dream-report.json"


def main() -> int:
    parser = argparse.ArgumentParser(description="Parthenos lucid-dream calibration")
    parser.add_argument("--store", help="S5 snapshot JSON path (optional)")
    parser.add_argument("--out", default=DEFAULT_OUT, help="report output path")
    args = parser.parse_args()

    if args.store:
        store = load_store_from_snapshot(args.store)
    else:
        store = GraphStore()

    report = run_report(store)
    write_report(report, args.out)
    print(f"wrote dream report -> {args.out} ({report['total_nodes']} nodes, "
          f"{len(report['proposals'])} proposals)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
