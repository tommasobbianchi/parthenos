[Unit]
Description=Parthenos agent-Telegram bridge (watches Athena inbox.ndjson)
After=network-online.target parthenos-mcp.service
Wants=parthenos-mcp.service

[Service]
Type=simple
ExecStart=%h/projects/Parthenos/deploy/agent-tg/bridge.py
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
